NODE_ENV=production
HOST=0.0.0.0
PORT=8088

# 可选：保留一个环境管理员账号；普通用户可直接在登录页注册。
# 密码只放在服务器环境变量中，不要写入代码或提交 Git。
APP_USERNAME=yusen
APP_PASSWORD=replace-with-a-strong-private-password

# 可选高级设置：Linux/宝塔默认会自动生成 data/config-secret.local，无需手动配置。
# 如需多机共享同一套加密配置，可固定填写至少 32 个字符，并妥善备份。
# SIF_CONFIG_SECRET=replace-with-a-random-secret-at-least-32-characters

# 可选：如果使用自建 SIF HTTP Bridge，在宝塔环境变量中填写。
# SIF_MCP_BRIDGE_URL=https://your-server.example.com/sif/query
# SIF_MCP_BRIDGE_TOKEN=replace-with-your-server-side-token
